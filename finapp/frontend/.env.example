# Firebase Web SDK config (Firebase Console > Project settings > General > Your apps)
# Safe to expose to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account (Firebase Console > Project settings > Service accounts).
# SECRET - never commit real values. Keep the private key double-quoted with literal \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Backend API consumed with the Firebase ID token as a Bearer token.
NEXT_PUBLIC_API_BASE_URL=https://localhost:5001
